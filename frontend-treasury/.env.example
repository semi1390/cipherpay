# Copy this file to ".env" (in the frontend-treasury/ folder) and fill it in.

# REQUIRED: an Arbitrum Sepolia JSON-RPC endpoint (used for on-chain READS).
# Use the same URL as TOKEN_RPC_URL in your scripts (the Arbitrum Sepolia one).
VITE_ARBITRUM_RPC_URL=

# REQUIRED: your deployed CipherPayrollTreasury address on Arbitrum Sepolia
# (the "treasury" field from deployment.payroll-treasury.json). The app reads the
# token address from the treasury automatically.
VITE_TREASURY_ADDRESS=
