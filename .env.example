# ---------------------------------------------------------------------------
# CipherPay Nox spike — environment
# Copy this file to ".env" and fill in the values. Never commit your real .env.
# ---------------------------------------------------------------------------

# An Ethereum Sepolia JSON-RPC endpoint.
# Get one from Alchemy (https://alchemy.com), Infura (https://infura.io),
# or any public Sepolia RPC. Example shape:
#   https://eth-sepolia.g.alchemy.com/v2/<YOUR_KEY>
SEPOLIA_RPC_URL=

# Private key (0x-prefixed) of a THROWAWAY dev wallet, funded with a little
# Sepolia test ETH. Use a burner account — never a key that holds real funds.
# Fund it from a faucet, e.g. https://cloud.google.com/application/web3/faucet/ethereum/sepolia
PRIVATE_KEY=

# Filled in AFTER you deploy: the address printed by `npm run deploy:sepolia`
# (also saved to deployment.json). Required by `npm run roundtrip:sepolia`.
CONTRACT_ADDRESS=

# Optional: how much to deposit in the round-trip test. Defaults to 1000.
DEPOSIT_AMOUNT=1000
