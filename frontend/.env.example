# Copy this file to ".env" (in the frontend/ folder) and fill it in.

# REQUIRED: a Sepolia JSON-RPC endpoint used for on-chain READS.
# Use the SAME URL as SEPOLIA_RPC_URL in your project's scripts (.env at the root).
# The injected wallet's RPC is unreliable for eth_call, so the SDK reads through this.
VITE_SEPOLIA_RPC_URL=

# OPTIONAL: pre-fill the application contract address field (your deployed CipherPayroll).
# You can also just paste it into the input on the page.
VITE_CONTRACT_ADDRESS=
